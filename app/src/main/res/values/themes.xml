<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.EHR" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/midnight</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/midnight</item>
    </style>
    <style name="Theme.EHR.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/midnight</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.EHR</item>
    </style>
</resources>
